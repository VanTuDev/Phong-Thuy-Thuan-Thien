# ── PRODUCTION (Vercel) ──────────────────────────────────────────────────────
# File này ĐƯỢC commit (chỉ chứa biến NEXT_PUBLIC_* — công khai, nằm trong bundle
# trình duyệt). Next.js tự đọc khi `next build` / `next start` ở NODE_ENV=production.
# Biến NEXT_PUBLIC_* nhúng vào bundle lúc BUILD → đổi giá trị phải Redeploy.
#
# >>> BẠN CẦN ĐIỀN: NEXT_PUBLIC_API_URL (URL backend trên Render) khi có. <<<

# URL backend Render — KHÔNG có "/" ở cuối.
NEXT_PUBLIC_API_URL=https://backend-phong-thuy-thuan-thien.onrender.com

# Google OAuth Client ID — cùng giá trị với GOOGLE_CLIENT_ID ở backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=200796214561-3e8pmonu1svn985drsajiqla5es0nq3f.apps.googleusercontent.com
