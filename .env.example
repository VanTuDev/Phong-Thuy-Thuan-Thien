# Mẫu cho `.env.local` (dev). Production → xem `.env.production` (đã commit).

# URL Backend-Thuan-Thien.
#   Bỏ TRỐNG  → tự suy ra từ host đang mở: <protocol>//<hostname>:4000
#              (mở bằng điện thoại cùng Wi-Fi http://192.168.1.2:3000 vẫn chạy).
#   Production → https://<backend>.onrender.com  (KHÔNG "/" cuối)
NEXT_PUBLIC_API_URL=

# Cổng API khi tự suy ra (mặc định 4000)
NEXT_PUBLIC_API_PORT=4000

# Google OAuth Client ID (project thuanthien-506711) — cùng giá trị với GOOGLE_CLIENT_ID ở backend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=200796214561-3e8pmonu1svn985drsajiqla5es0nq3f.apps.googleusercontent.com
