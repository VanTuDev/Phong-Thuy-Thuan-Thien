# ── Sao chép thành `.env.local` (dev) hoặc đặt trong Vercel → Settings → Environment Variables ──

# URL công khai của Backend (Railway). BẮT BUỘC khi deploy.
#   Dev:  để TRỐNG  → tự suy ra <host đang mở>:<NEXT_PUBLIC_API_PORT>
#   Prod: https://<ten-app>.up.railway.app   (KHÔNG có dấu "/" ở cuối)
NEXT_PUBLIC_API_URL=

# Cổng API khi tự suy ra ở dev (bỏ qua khi đã set NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_API_PORT=4000

# Google OAuth Client ID — CÙNG giá trị với GOOGLE_CLIENT_ID ở backend.
#   Trống → nút "Đăng nhập demo". Có → nút Google Identity Services thật.
#   Nhớ thêm domain Vercel vào "Authorized JavaScript origins" trong Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
